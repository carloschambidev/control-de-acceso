const app = express();
app.use(express.json());

app.post("/enviar-datos", async (req, res) => {
  try {
    const data = req.body;                    // Datos enviados por el Arduino



    // Autenticación con la API de Google Sheets

    await client.authorize();
    const sheets = google.sheets({ version: "v4", auth: client });



    // Agregar los datos a la hoja de cálculo

    await sheets.spreadsheets.values.append({
      spreadsheetId,
      range: "A1",                                // Rango donde deseas agregar los datos
      valueInputOption: "RAW",
      insertDataOption: "INSERT_ROWS",
      resource: {
        values: [[data.value1, data.value2]]       // Valores enviados desde el Arduino
      }
    });

    res.status(200).send("Datos agregados a Google Sheets");
  } catch (error) {
    console.error("Error:", error);
    res.status(500).send("Error al agregar los datos");
  }
});




// Inicia el servidor

const port = 8080;
app.listen(port, () => {
  console.log(`Servidor en funcionamiento en el puerto ${port}`);
});




